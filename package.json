{
  "name": "@macawkit/base",
  "version": "0.4.0",
  "description": "Base classes for MacawKit projects",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "browser": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean && tsc -p tsconfig.build.json",
    "build": "node build.mjs",
    "build:tests": "npm run build test",
    "build:release": "npm run build release",
    "pretest": "npm run --silent build:tests",
    "test": "node --test --test-reporter=spec dist/index.test.js",
    "test:coverage": "node --enable-source-maps --test --experimental-test-coverage --test-coverage-exclude='**/node_modules/**' --test-coverage-exclude='**/test/**' dist/index.test.js",
    "lint": "eslint .",
    "prepack": "npm run build:release"
  },
  "author": {
    "name": "Yury Gubich",
    "email": "blue@macaw.me"
  },
  "repository": {
    "url": "git+https://github.com/macawkit/base.git",
    "type": "git"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "eslint": "^10.12.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
