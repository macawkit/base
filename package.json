{
  "name": "@macawkit/base",
  "version": "0.3.0",
  "description": "Base classes for MacawKit projects",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "rm -rf dist dist-test",
    "build": "tsc -p tsconfig.build.json",
    "prebuild": "npm run clean",
    "build:tests": "tsc -p tsconfig.test.json",
    "pretest": "npm run build && npm run build:tests",
    "test": "node --test --test-reporter=spec dist-test/test",
    "test:coverage": "node --test --experimental-test-coverage dist-test/test",
    "lint": "eslint .",
    "prepack": "npm run build"
  },
  "author": {
    "name": "Yury Gubich",
    "email": "blue@macaw.me"
  },
  "repository": {
    "url": "git+https://github.com/macawkit/base",
    "type": "git"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
